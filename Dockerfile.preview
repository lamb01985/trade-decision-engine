FROM python:3.11-slim
WORKDIR /service
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY app ./app
ENV TRADEHUB_DEPLOYMENT_STAGE=preview MASSIVE_BUDGET_ENFORCED=true
EXPOSE 8080
CMD ["uvicorn", "app.market_data.preview_app:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "1", "--no-access-log"]
