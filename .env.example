MASSIVE_API_KEY=
# local (default) keeps SQLite/research files; hosted disables project-filesystem writes.
APP_STORAGE_MODE=local
# Optional Stage 2B durable store. Omitting DATABASE_URL preserves legacy local SQLite paths.
DATABASE_BACKEND=sqlite
# DATABASE_URL=sqlite:///data/application.sqlite3
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/trade_decision_engine
DB_CONNECT_TIMEOUT_SECONDS=5
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT_SECONDS=5
DB_POOL_RECYCLE_SECONDS=300
# Hosted background execution is explicit opt-in. Leave both false through Phase 3A rollout.
HOSTED_SCANNER_ENABLED=false
NOTIFICATIONS_ENABLED=false
# Conservative REST cadence: regular / premarket / closed-weekend seconds.
SCANNER_REFRESH_SECONDS=300
SCANNER_PREMARKET_INTERVAL_SECONDS=600
SCANNER_CLOSED_INTERVAL_SECONDS=1800
SCANNER_STALE_AFTER_SECONDS=900
SCANNER_CYCLE_LEASE_SECONDS=900
HOSTED_SCANNER_WATCHLIST=QQQ,SPY,IWM,SMH,NVDA,AMD,AMZN,META,AAPL,MSFT,AVGO,TSLA,GOOGL
HOSTED_SCANNER_ADDITIONAL_SYMBOLS=
HOSTED_SCANNER_INCLUDE_NASDAQ_100=false
HOSTED_SCANNER_INCLUDE_SP500=false
PUSHOVER_USER_KEY=
PUSHOVER_APP_TOKEN=
PUBLIC_APP_BASE_URL=
CORS_ALLOWED_ORIGINS=
